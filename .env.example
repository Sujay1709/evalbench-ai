APP_ENV=development
SECRET_KEY=replace-this-for-non-local-use
DATABASE_URL=sqlite:///evalbench.db
# Supabase/PostgreSQL alternative: copy the direct or Session pooler URL from Connect.
# DATABASE_URL=postgresql+psycopg://evalbench_runtime:PERCENT_ENCODED_PASSWORD@HOST:5432/postgres
# Download the database CA certificate from Supabase; never disable hosted TLS.
# DATABASE_SSL_ROOT_CERT=/absolute/path/to/supabase-ca.crt
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DEMO_READ_ONLY=false
LOG_LEVEL=INFO
LLM_PROVIDER=mock
MAX_RUN_COST_USD=1.00
# OPENAI_API_KEY=replace-with-a-local-development-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=128
# Optional estimate inputs. Configure both using the pricing you intentionally choose.
# OPENAI_INPUT_USD_PER_MILLION=0.00
# OPENAI_OUTPUT_USD_PER_MILLION=0.00
# Optional local Kev sidecar; keep it on loopback and pin --expected-run to a Hub commit SHA.
KEV_BASE_URL=http://127.0.0.1:8009
KEV_TIMEOUT_SECONDS=30
# KEV_API_KEY=replace-with-local-kev-key-if-enabled
INNGEST_DEV=1
INNGEST_APP_ID=evalbench
# INNGEST_EVENT_KEY=replace-with-an-inngest-event-key
# INNGEST_SIGNING_KEY=replace-with-an-inngest-signing-key
